<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark-mode palette: light text on the charcoal SAIC night artwork. -->
    <color name="text_primary">#f2f5f7</color>
    <color name="text_secondary">#99ffffff</color>
    <color name="text_tertiary">#52ffffff</color>
    <!-- The day-time blue is SAIC's own (#056eff, the launcher's carplay button), and on the
         night background it falls to 3:1 against text that should read at 4.5:1 — it looks
         muddy rather than bright. The constructor solves it the same way in its own dark
         theme: vehiclesettings keeps charging_mode_color at #4b8fff by day and lifts it to
         #b2cfff at night. This sits between the two, at 6.2:1, bright enough to read at a
         glance without turning the accent into a highlighter. -->
    <color name="accent">#7fb0ff</color>
    <color name="accent_pressed">#5d95e6</color>
    <color name="scrim">#99000000</color>
    <color name="drawer_background">#f21e1f22</color>

    <!-- The tonal buttons invert at night: a wash of white instead of one of black, which
         over the charcoal artwork is the difference between a visible surface and none. The
         outline does the rest of the work at the edges. -->
    <color name="button_surface">#26ffffff</color>
    <color name="button_surface_pressed">#4dffffff</color>
    <color name="button_border">#33ffffff</color>
    <color name="choice_border">#33ffffff</color>
    <color name="choice_selected">#33ffffff</color>

    <!-- The two arrival-charge warnings, which were never given a night value and so kept
         their daylight ones: #b3261e reads at 2.5:1 on this background and #b26a00 at 3.9:1,
         against the 4.5:1 a line of text needs. On the car the red was simply not there.
         These are the same two tones lifted for a dark ground, 7.2:1 and 9.5:1, and they stay
         well apart in hue — which is what carries the meaning, since at equal lightness an
         amber always looks brighter than a red and no amount of tuning changes that. -->
    <color name="charge_low">#ffb74d</color>
    <color name="charge_none">#ff8a80</color>
</resources>