<?xml version="1.0" encoding="utf-8"?>
<!-- Sizes are tuned for an automotive head unit (1920x720, viewed at arm's length), so
     icons and text are deliberately large for legibility while driving.

     Text sizes follow the factory launcher's own vocabulary, read from its layouts: card
     title 30, body/label 28, emphasised value 32, button 26, secondary 20. It declares
     those in px and this app in sp, which coincide at the head unit's density and font
     scale; sp additionally follows a system font-size setting, px does not. -->
<resources>
    <dimen name="screen_padding">24dp</dimen>
    <dimen name="card_gap">16dp</dimen>
    <dimen name="favorite_icon_size">160dp</dimen>
    <dimen name="favorite_label_size">30sp</dimen>
    <dimen name="small_card_label_size">30sp</dimen>
    <dimen name="drawer_title_size">30sp</dimen>
    <dimen name="drawer_button_size">26sp</dimen>
    <dimen name="drawer_icon_size">88dp</dimen>
    <dimen name="drawer_label_size">20sp</dimen>
    <dimen name="fixed_app_padding">24dp</dimen>
    <dimen name="native_button_radius">10dp</dimen>
    <dimen name="native_button_padding_h">24dp</dimen>
    <dimen name="native_button_padding_v">12dp</dimen>
    <dimen name="info_card_padding">24dp</dimen>
    <dimen name="info_card_body_size">28sp</dimen>
    <dimen name="secondary_text_size">20sp</dimen>
    <!-- Technical details are reference material, not glanceable while driving, so
         that card sits a tier below the rest of the launcher. -->
    <dimen name="sys_value_size">26sp</dimen>
    <dimen name="grid_icon_size">140dp</dimen>
    <dimen name="grid_label_size">28sp</dimen>
    <!-- Charging screen: tab height and text match the SAIC top tab bar. -->
    <dimen name="filter_tab_height">85dp</dimen>
    <dimen name="charge_list_width">640dp</dimen>
    <!-- The system tab bar sits at 28sp, and the settings tabs match it: they span a whole
         card. The charging filters cannot — four long labels share 640dp there. -->
    <!-- 18, not 20: the tabs are inset by charge_list_inset to line up with the rows below,
         and at 20sp the longest label ("Ricarica rapida") no longer fitted one line. -->
    <dimen name="filter_tab_text_size">18sp</dimen>
    <dimen name="settings_tab_text_size">28sp</dimen>
    <dimen name="settings_tab_height">72dp</dimen>
    <!-- The card artwork paints its own shadow, and it stretches with the view: on a
         full-width card the left edge alone eats about 48dp, far more than the 24dp used
         on the narrow cards. These keep the text on the card face instead of the shadow. -->
    <dimen name="diagnostics_padding_h">48dp</dimen>
    <dimen name="diagnostics_padding_top">20dp</dimen>
    <dimen name="diagnostics_padding_bottom">56dp</dimen>
    <!-- Stack traces, not prose: small and dense beats legible-at-a-glance. -->
    <dimen name="diagnostics_text_size">16sp</dimen>
    <dimen name="settings_toggle_height">88dp</dimen>
    <!-- Charging card backdrop. The bolt never fills the box it is given — no scaleType
         nor a background drawable made it do so — so these numbers were tuned by eye on the
         head-unit emulator rather than derived. The two margins differ because the card
         artwork paints a much heavier shadow along its bottom edge than down its side, so
         equal values look lopsided; these leave a comparable visible gap on both. -->
    <dimen name="charging_bolt_width">150dp</dimen>
    <dimen name="charging_bolt_height">196dp</dimen>
    <dimen name="charging_bolt_margin_end">36dp</dimen>
    <dimen name="charging_bolt_margin_bottom">8dp</dimen>
    <dimen name="charge_item_height">116dp</dimen>
    <!-- The row artwork paints its own shadow: the solid card face starts ~30dp in on the
         left and ends ~35dp before the right edge once stretched to the list width. These
         keep the content on the card rather than on the shadow. -->
    <!-- How far the rows of the charging list sit inside their column. Not a margin we
         chose: the row artwork (app_normal_bg.png, 216x206) carries a 10px shadow on each
         side, and stretched across a 640dp row that band is 30dp. Anything meant to line up
         with the rows — the filter tabs above them, the attribution below — has to start
         here, or it looks like the list is narrower than the header. -->
    <dimen name="charge_list_inset">30dp</dimen>
    <dimen name="charge_item_padding_start">44dp</dimen>
    <dimen name="charge_item_padding_end">48dp</dimen>
    <dimen name="charge_item_title_size">28sp</dimen>
    <dimen name="page_indicator_active_width">32dp</dimen>
    <dimen name="page_indicator_inactive_width">16dp</dimen>
    <dimen name="page_indicator_height">6dp</dimen>
    <dimen name="page_indicator_margin_bottom">12dp</dimen>

    <!-- Charging card: station names carry the system body size, their distance and power
         one step below it. Both were 20sp, which read as fine print next to a 30sp title. -->
    <dimen name="charge_name_size">28sp</dimen>
    <dimen name="charge_detail_size">24sp</dimen>

    <!-- Round action button sitting in a card corner. Sized like the settings tabs so it is
         the same target a gloved hand already hits elsewhere. -->
    <dimen name="round_button_size">72dp</dimen>
    <dimen name="round_button_icon_padding">18dp</dimen>

    <!-- Padding inside the charging card. Two things decide it. First the artwork: the card
         art (bg_normal.png, 429x298) paints its own drop shadow inside the bitmap, 11px on
         the left of 429, and it is a plain PNG rather than a nine-patch, so the band stretches
         with the view — across the 1237dp this card spans that is 32dp on the left and 29dp
         on the right, which is why text at 24dp sat on the shadow. Clearing the shadow is the
         floor, not the answer: at 40dp the text cleared it by 8dp and still read as cramped.
         56dp leaves about 24dp of visible margin inside the card, which is the air. Recheck
         both numbers whenever the card changes width. -->
    <dimen name="charging_card_padding_h">56dp</dimen>
    <!-- Same reasoning vertically: 13dp of shadow at the top, 16dp at the bottom. -->
    <dimen name="charging_card_padding_v">32dp</dimen>

    <!-- Icon sitting next to a label inside a button, sized to the text beside it. -->
    <dimen name="button_icon_size">36dp</dimen>

    <!-- Glyphs on the charging details line. Heights match so bolt, euro and padlock sit on
         the same baseline; the widths keep each glyph's own proportions. -->
    <!-- Four single lines plus room to breathe. Fixed, not wrapped: see the panel itself. -->
    <dimen name="charge_detail_panel_height">184dp</dimen>
    <!-- The detail panel spans the map, about 1150dp, so its shadow band is 29dp: the list
         row padding it borrowed left only 15dp of visible margin. -->
    <dimen name="charge_detail_padding_h">56dp</dimen>
    <dimen name="charge_glyph_height">21dp</dimen>
    <dimen name="charge_glyph_width_bolt">12dp</dimen>
    <dimen name="charge_glyph_width_lock">16dp</dimen>
    <dimen name="charge_glyph_width_battery">13dp</dimen>

    <!-- Downloads list: three lines of text beside a button, so a touch taller than the
         charging rows, which carry two. -->
    <dimen name="catalog_item_height">140dp</dimen>
    <dimen name="catalog_action_width">240dp</dimen>
</resources>
