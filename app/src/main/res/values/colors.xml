<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Carried over from the original SAIC launcher palette for visual consistency. -->
    <color name="text_primary">#3c4143</color>
    <color name="text_secondary">#7f3c4143</color>
    <!-- Dimmed tone the SAIC tab bar uses for unselected tabs. -->
    <color name="text_tertiary">#503c4143</color>
    <color name="accent">#056eff</color>
    <color name="accent_pressed">#0455cc</color>
    <color name="scrim">#66000000</color>

    <!-- Arrival charge: comfortable, thin, out of reach. Muted on purpose — these sit in a
         list the driver scans, and a saturated red row would shout over the station names. -->
    <color name="charge_low">#b26a00</color>
    <color name="charge_none">#b3261e</color>
    <color name="drawer_background">#f2ffffff</color>

    <!-- Tonal surface for the native-style drawer buttons (tints of text_primary). -->
    <color name="button_surface">#1f3c4143</color>
    <color name="button_surface_pressed">#3d3c4143</color>

    <!-- The line under a row of readings: present enough to group, faint enough to ignore. -->
    <color name="hairline">#14000000</color>
</resources>
