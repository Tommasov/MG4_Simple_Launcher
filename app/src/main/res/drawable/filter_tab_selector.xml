<?xml version="1.0" encoding="utf-8"?>
<!-- Background for one filter tab, reusing the original SAIC tab artwork so the charging
     screen reads as part of the native system. Day and night variants both ship. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:drawable="@drawable/tab_clicked" />
    <item android:state_selected="true" android:drawable="@drawable/tab_clicked" />
    <item android:drawable="@drawable/tab_normal" />
</selector>
