<?xml version="1.0" encoding="utf-8"?>
<!-- One row inside a choice group: filled when it is the one in force, otherwise nothing.
     No outline of its own — the group draws that — so the rows read as compartments of a
     single control rather than as buttons stacked on top of each other. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/choice_selected" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/button_surface" />
        </shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
