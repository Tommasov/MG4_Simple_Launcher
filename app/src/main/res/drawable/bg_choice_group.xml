<?xml version="1.0" encoding="utf-8"?>
<!-- The frame around a set of mutually exclusive choices. One outline holds the whole group,
     so the eye reads "one of these" instead of three separate buttons. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <stroke android:width="1dp" android:color="@color/choice_border" />
    <corners android:radius="@dimen/native_button_radius" />
</shape>
