<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/drawer_back_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:background="@drawable/native_button_selector"
            android:clickable="true"
            android:contentDescription="@string/cd_back"
            android:focusable="true"
            android:padding="@dimen/native_button_padding_v"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/drawer_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/drawer_title_size"
            android:textStyle="bold"
            tools:ignore="HardcodedText"
            xmlns:tools="http://schemas.android.com/tools" />

        <!-- The launcher's own two screens. They live here because this header is the one
             surface that is always present: the All apps card is fixed on the home page,
             unlike the dock beside it, and unlike the charging page these two used to hang
             off — which is about to become something a driver can switch off entirely.

             Words, not icons. The button next to them says "System apps", and a header that
             mixes a text chip with two icon chips reads as two different kinds of control;
             the icons also had to be fought into shape, being 96dp artwork drawn for the
             home cards. There is room for three labels on a screen this wide. -->
        <TextView
            android:id="@+id/drawer_downloads_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:background="@drawable/native_button_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="@dimen/native_button_padding_h"
            android:paddingVertical="@dimen/native_button_padding_v"
            android:text="@string/downloads_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/drawer_button_size" />

        <TextView
            android:id="@+id/drawer_settings_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:background="@drawable/native_button_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="@dimen/native_button_padding_h"
            android:paddingVertical="@dimen/native_button_padding_v"
            android:text="@string/settings_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/drawer_button_size" />

        <!-- Two switches, because while picking there are three lists to move between:
             apps, Android's screens and the car's. Which labels they carry is decided in
             code, since it depends on where you already are. -->
        <TextView
            android:id="@+id/secondary_header_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:background="@drawable/native_button_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="@dimen/native_button_padding_h"
            android:paddingVertical="@dimen/native_button_padding_v"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/drawer_button_size"
            android:visibility="gone" />

        <TextView
            android:id="@+id/system_apps_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/native_button_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="@dimen/native_button_padding_h"
            android:paddingVertical="@dimen/native_button_padding_v"
            android:text="@string/system_apps"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/drawer_button_size" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/app_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:scrollbars="vertical" />

        <!-- A list can legitimately come back empty — a vehicle whose software this build
             does not recognise — and an empty screen with no explanation reads as a fault. -->
        <TextView
            android:id="@+id/drawer_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="@dimen/info_card_padding"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/info_card_body_size"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
