<?xml version="1.0" encoding="utf-8"?>
<!-- One station summarised on the tools page charging card: name, then operator, distance
     and power on a second line. Included six times, so the ids live on the <include> tag. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/charge_summary_gap"
    android:orientation="vertical">

    <TextView
        android:id="@+id/summary_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/charge_name_size"
        android:textStyle="bold" />

    <!-- Distance and power, then whatever else is known, on one line: the card is wide
         enough that these cost no height here, unlike in the map list. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/summary_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="14dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/charge_detail_size" />

        <include
            layout="@layout/part_charge_extras"
            android:id="@+id/summary_extras"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <!-- Charge left on arrival, last on the line: it is the only figure here that
             depends on the car rather than on the station, and it is what decides whether
             the rest of the row is worth reading. Hidden when the car has not answered. -->
        <ImageView
            android:id="@+id/summary_arrival_icon"
            android:layout_width="@dimen/charge_glyph_width_battery"
            android:layout_height="@dimen/charge_glyph_height"
            android:contentDescription="@null"
            android:src="@drawable/ic_glyph_battery"
            android:visibility="gone" />

        <TextView
            android:id="@+id/summary_arrival"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/charge_detail_size"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
