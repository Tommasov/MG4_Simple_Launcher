<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher settings. Landscape (MG4 head unit): one card per setting, side by side like
     every other page. Stacked full-width cards were tried first and do not work here — the
     card artwork carries its own intrinsic height, so a full-width card grows far taller
     than its content and pushes the rest off screen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/settings_back_button"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/icon_press_selector"
            android:clickable="true"
            android:contentDescription="@string/cd_back"
            android:focusable="true"
            android:padding="12dp"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/settings_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/drawer_title_size"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/card_gap"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- Which page opens on launch -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/card_gap"
            android:layout_weight="1"
            android:background="@drawable/smallcard_selector"
            android:orientation="vertical"
            android:padding="@dimen/info_card_padding">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_home_page"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/small_card_label_size"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/settings_home_page_hint"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/info_card_body_size" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="16dp" />

            <!-- Stacked rather than in a row: three tabs side by side inside one card would
                 leave each too narrow for its label. -->
            <RadioGroup
                android:id="@+id/settings_home_page_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/home_page_main"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/settings_tab_height"
                    android:background="@drawable/filter_tab_selector"
                    android:button="@null"
                    android:checked="true"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/settings_page_home"
                    android:textColor="@color/filter_tab_text"
                    android:textSize="@dimen/settings_tab_text_size" />

                <RadioButton
                    android:id="@+id/home_page_shortcuts"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/settings_tab_height"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/filter_tab_selector"
                    android:button="@null"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/settings_page_shortcuts"
                    android:textColor="@color/filter_tab_text"
                    android:textSize="@dimen/settings_tab_text_size" />

                <RadioButton
                    android:id="@+id/home_page_system"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/settings_tab_height"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/filter_tab_selector"
                    android:button="@null"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/settings_page_system"
                    android:textColor="@color/filter_tab_text"
                    android:textSize="@dimen/settings_tab_text_size" />
            </RadioGroup>
        </LinearLayout>

        <!-- Switchable features. A list rather than a single control, so new toggles are
             one <include> away; it scrolls once there are more than the card can show. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/card_gap"
            android:layout_weight="1"
            android:background="@drawable/smallcard_selector"
            android:orientation="vertical"
            android:padding="@dimen/info_card_padding">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_features"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/small_card_label_size"
                android:textStyle="bold" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="14dp"
                android:layout_weight="1"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/settings_feature_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        layout="@layout/part_settings_toggle"
                        android:id="@+id/toggle_shortcuts_page" />

                    <include
                        layout="@layout/part_settings_toggle"
                        android:id="@+id/toggle_beta_channel" />
                </LinearLayout>
            </ScrollView>
        </LinearLayout>

        <!-- Updates -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/card_gap"
            android:layout_weight="1"
            android:background="@drawable/smallcard_selector"
            android:orientation="vertical"
            android:padding="@dimen/info_card_padding">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_updates"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/small_card_label_size"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/settings_version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/info_card_body_size" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="16dp" />

            <TextView
                android:id="@+id/settings_check_updates"
                android:layout_width="match_parent"
                android:layout_height="@dimen/settings_tab_height"
                android:background="@drawable/native_button_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/update_check_action"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/drawer_button_size" />
        </LinearLayout>

        <!-- System: the two screens you only open when something wants looking at. They
             share a card because they answer the same question — what is this thing doing —
             and because neither is worth a carousel page nobody reads while driving. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/smallcard_selector"
            android:orientation="vertical"
            android:padding="@dimen/info_card_padding">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_system"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/small_card_label_size"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/settings_diagnostics_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/info_card_body_size" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="16dp" />

            <TextView
                android:id="@+id/settings_open_technical"
                android:layout_width="match_parent"
                android:layout_height="@dimen/settings_tab_height"
                android:background="@drawable/native_button_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/sys_technical"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/drawer_button_size" />

            <TextView
                android:id="@+id/settings_open_diagnostics"
                android:layout_width="match_parent"
                android:layout_height="@dimen/settings_tab_height"
                android:layout_marginTop="12dp"
                android:background="@drawable/native_button_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/diagnostics_open"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/drawer_button_size" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
