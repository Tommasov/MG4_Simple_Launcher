<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher settings, in four columns across the head unit's width.

     No cards. On a page made of cards the driver's thumb goes to swipe them, because on every
     other page of this launcher a card is something you move between — and here there is
     nothing to swipe to, so the gesture just fails. Headings with a rule under them group the
     same content without promising a carousel that does not exist.

     Stacked full-width cards were tried before that and failed differently: the card artwork
     carries its own intrinsic height, so a full-width card grows far taller than its content
     and pushes the rest off screen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/settings_back_button"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/icon_press_selector"
            android:clickable="true"
            android:contentDescription="@string/cd_back"
            android:focusable="true"
            android:padding="12dp"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/settings_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/drawer_title_size"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/card_gap"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- Which page opens on launch -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/card_gap"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingTop="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_home_page"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/info_card_title_size"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="12dp"
                android:background="@color/hairline" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/settings_home_page_hint"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/info_card_body_size" />

            <!-- A fixed gap, not a stretching one: with the cards gone there is no box for
                 the empty space to belong to, so pushing the buttons to the bottom edge left
                 each column looking like it had lost its middle. -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="20dp" />

            <!-- Stacked rather than in a row: three tabs side by side inside one card would
                 leave each too narrow for its label. -->
            <RadioGroup
                android:id="@+id/settings_home_page_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/home_page_main"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/settings_tab_height"
                    android:background="@drawable/filter_tab_selector"
                    android:button="@null"
                    android:checked="true"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/settings_page_home"
                    android:textColor="@color/filter_tab_text"
                    android:textSize="@dimen/settings_tab_text_size" />

                <RadioButton
                    android:id="@+id/home_page_shortcuts"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/settings_tab_height"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/filter_tab_selector"
                    android:button="@null"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/settings_page_shortcuts"
                    android:textColor="@color/filter_tab_text"
                    android:textSize="@dimen/settings_tab_text_size" />

                <RadioButton
                    android:id="@+id/home_page_system"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/settings_tab_height"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/filter_tab_selector"
                    android:button="@null"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/settings_page_charging"
                    android:textColor="@color/filter_tab_text"
                    android:textSize="@dimen/settings_tab_text_size" />
            </RadioGroup>
        </LinearLayout>

        <!-- Switchable features. A list rather than a single control, so new toggles are
             one <include> away; it scrolls once there are more than the card can show. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/card_gap"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingTop="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_features"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/info_card_title_size"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="12dp"
                android:background="@color/hairline" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="14dp"
                android:layout_weight="1"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/settings_feature_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        layout="@layout/part_settings_toggle"
                        android:id="@+id/toggle_shortcuts_page" />

                    <include
                        layout="@layout/part_settings_toggle"
                        android:id="@+id/toggle_six_tile_home" />

                    <include
                        layout="@layout/part_settings_toggle"
                        android:id="@+id/toggle_update_on_launch" />

                    <include
                        layout="@layout/part_settings_toggle"
                        android:id="@+id/toggle_beta_channel" />

                </LinearLayout>
            </ScrollView>
        </LinearLayout>

        <!-- What the launcher has to be told about this particular car. Both of these are
             facts the vehicle knows and will not report: no adapter call gives the pack size,
             and nothing at all knows when MG's data allowance renews. They sit together
             because they are the same kind of thing — the car's own details — rather than
             settings about how the launcher behaves. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/card_gap"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingTop="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_vehicle"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/info_card_title_size"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="12dp"
                android:background="@color/hairline" />

            <LinearLayout
                android:id="@+id/settings_battery_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/icon_press_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_battery"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/charge_item_title_size" />

                <TextView
                    android:id="@+id/settings_battery_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/charge_item_title_size" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_battery_hint"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/secondary_text_size" />
        </LinearLayout>

        <!-- The launcher itself: which version is installed, whether a newer one exists, and
             the two screens you open when something wants looking at. Updates used to have a
             column of their own for one line and one button; they answer the same question as
             the rest of this one — what is this thing doing — so they share it. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingTop="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_system"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/info_card_title_size"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="12dp"
                android:background="@color/hairline" />

            <TextView
                android:id="@+id/settings_version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/info_card_body_size" />

            <TextView
                android:id="@+id/settings_diagnostics_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/info_card_body_size" />

            <!-- A fixed gap, not a stretching one: with the cards gone there is no box for
                 the empty space to belong to, so pushing the buttons to the bottom edge left
                 each column looking like it had lost its middle. -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="20dp" />

            <TextView
                android:id="@+id/settings_open_technical"
                android:layout_width="match_parent"
                android:layout_height="@dimen/settings_tab_height"
                android:background="@drawable/native_button_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/sys_technical"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/drawer_button_size" />

            <TextView
                android:id="@+id/settings_check_updates"
                android:layout_width="match_parent"
                android:layout_height="@dimen/settings_tab_height"
                android:layout_marginTop="12dp"
                android:background="@drawable/native_button_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/update_check_action"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/drawer_button_size" />

            <TextView
                android:id="@+id/settings_open_diagnostics"
                android:layout_width="match_parent"
                android:layout_height="@dimen/settings_tab_height"
                android:layout_marginTop="12dp"
                android:background="@drawable/native_button_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/diagnostics_open"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/drawer_button_size" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
