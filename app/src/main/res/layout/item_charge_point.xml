<?xml version="1.0" encoding="utf-8"?>
<!-- One charging station in the left-hand list. Same card artwork as the drawer tiles, so
     the row highlights on press exactly like the rest of the launcher.
     Two lines, not three: the operator and the connectors share the second one. Kept apart
     they crowded the row's lower edge, and the operator frequently just repeated the title
     ("Enel X" under "Enel X").

     Bays, access and price briefly lived here as a third line and did not fit: the text
     column is about 340dp, and a price is often a whole sentence. They moved to the panel
     that opens over the map when a station is picked, where there is room to read them. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/charge_item_height"
    android:layout_marginBottom="12dp"
    android:background="@drawable/charge_item_selector"
    android:baselineAligned="false"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/charge_item_padding_start"
    android:paddingEnd="@dimen/charge_item_padding_end">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/charge_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/charge_item_title_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/charge_operator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/secondary_text_size" />



    </LinearLayout>

    <!-- Distance and power: the two numbers that decide whether to stop here. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/charge_distance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/charge_item_title_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/charge_power"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/accent"
            android:textSize="@dimen/secondary_text_size"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageView
        android:id="@+id/charge_navigate"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/icon_press_selector"
        android:clickable="true"
        android:contentDescription="@string/charging_navigate"
        android:focusable="true"
        android:padding="12dp"
        android:src="@drawable/ic_navigate" />
</LinearLayout>
