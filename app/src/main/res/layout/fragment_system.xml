<?xml version="1.0" encoding="utf-8"?>
<!-- Carousel page 3: live system information, refreshed while the page is visible.
     All values are read without dangerous permissions. Landscape (MG4 head unit).
     Charging points come first; the "technical details" card closes the row, with two
     slots still free for features to be designed. The card scrolls only if its content
     ever outgrows it — fillViewport keeps the weighted spacing when it doesn't. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:baselineAligned="false"
    android:padding="@dimen/screen_padding">

    <!-- Charging points: the nearest motorway and Supercharger sites, tap for the map.
         The bolt sits behind the text rather than below it, so six entries fit without
         giving up the graphic backdrop. -->
    <FrameLayout
        android:id="@+id/charging_card"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginEnd="@dimen/card_gap"
        android:background="@drawable/smallcard_selector"
        android:clickable="true"
        android:focusable="true">

        <!-- Explicit size: at wrap_content the bolt would stay at the drawable's intrinsic
             36dp. Set as the background rather than the src: a background always fills the
             view bounds exactly, while every scaleType left slack inside the box and the
             bolt floated well above where the margins said it should sit. The box keeps the
             source 36:47 ratio to within 0.1%, so nothing is visibly stretched. -->
        <ImageView
            android:layout_width="@dimen/charging_bolt_width"
            android:layout_height="@dimen/charging_bolt_height"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="@dimen/charging_bolt_margin_end"
            android:layout_marginBottom="@dimen/charging_bolt_margin_bottom"
            android:alpha="0.12"
            android:background="@drawable/ic_charging_bolt"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="@dimen/info_card_padding">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/charging_title"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/small_card_label_size"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/charging_card_results"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/charge_group_motorway"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="@string/charging_filter_motorway"
                    android:textColor="@color/accent"
                    android:textSize="@dimen/secondary_text_size"
                    android:textStyle="bold" />

            <include layout="@layout/part_charge_summary" android:id="@+id/charge_row_0" />
            <include layout="@layout/part_charge_summary" android:id="@+id/charge_row_1" />
            <include layout="@layout/part_charge_summary" android:id="@+id/charge_row_2" />

                <TextView
                    android:id="@+id/charge_group_supercharger"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"
                    android:text="@string/charging_filter_supercharger"
                    android:textColor="@color/accent"
                    android:textSize="@dimen/secondary_text_size"
                    android:textStyle="bold" />

            <include layout="@layout/part_charge_summary" android:id="@+id/charge_row_3" />
            <include layout="@layout/part_charge_summary" android:id="@+id/charge_row_4" />
            <include layout="@layout/part_charge_summary" android:id="@+id/charge_row_5" />
            </LinearLayout>

            <TextView
                android:id="@+id/charging_card_status"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="16dp"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/info_card_body_size" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/charging_attribution"
                android:textColor="@color/text_tertiary"
                android:textSize="@dimen/secondary_text_size" />
        </LinearLayout>
    </FrameLayout>

    <!-- What the car says about itself, through the adapter service. The values here are
         the ones with a real implementation behind them: the air-quality getters that used
         to fill this card are empty stubs in the firmware. Blank on anything that is not
         this car, so the card states that rather than showing empty rows. -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginEnd="@dimen/card_gap"
        android:background="@drawable/smallcard_selector"
        android:orientation="vertical"
        android:padding="@dimen/info_card_padding">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vehicle_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/small_card_label_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/vehicle_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/info_card_body_size" />

        <LinearLayout
            android:id="@+id/vehicle_readings"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="gone">

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="16dp" />

            <TextView
                android:id="@+id/vehicle_battery_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vehicle_battery"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/secondary_text_size" />

            <TextView
                android:id="@+id/vehicle_battery_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/sys_value_size"
                android:textStyle="bold" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vehicle_range"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/secondary_text_size" />

            <TextView
                android:id="@+id/vehicle_range_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/sys_value_size"
                android:textStyle="bold" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vehicle_odometer"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/secondary_text_size" />

            <TextView
                android:id="@+id/vehicle_odometer_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/sys_value_size"
                android:textStyle="bold" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="16dp" />
        </LinearLayout>
    </LinearLayout>
    <!-- Launcher settings. Summarises what is on so the card says something before it is
         tapped, the way the other cards on this page do. -->
    <LinearLayout
        android:id="@+id/settings_card"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginEnd="@dimen/card_gap"
        android:background="@drawable/smallcard_selector"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="@dimen/info_card_padding">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/small_card_label_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/settings_card_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lineSpacingExtra="6dp"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/info_card_body_size" />
    </LinearLayout>

    <!-- Technical details: device, memory, storage, network -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/smallcard_selector"
        android:fillViewport="true"
        android:padding="@dimen/info_card_padding"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sys_technical"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/small_card_label_size"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_device_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:lineSpacingExtra="6dp"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/secondary_text_size" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="16dp" />

            <!-- Memory -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sys_memory"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/secondary_text_size" />

            <TextView
                android:id="@+id/tv_memory_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/sys_value_size"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sys_used_total"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/secondary_text_size" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="16dp" />

            <!-- Storage -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sys_storage"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/secondary_text_size" />

            <TextView
                android:id="@+id/tv_storage_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/sys_value_size"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sys_free_total"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/secondary_text_size" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="16dp" />

            <!-- Network -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sys_network"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/secondary_text_size" />

            <TextView
                android:id="@+id/tv_network_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/sys_value_size"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_network_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/secondary_text_size" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
