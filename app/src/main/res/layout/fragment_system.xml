<?xml version="1.0" encoding="utf-8"?>
<!-- Carousel page 3: charging points and launcher settings, landscape (MG4 head unit).
     Two cards, not four. The charging card takes two thirds of the row because it is the
     one with something to say while driving, and its two networks sit side by side rather
     than stacked, which is what let the entries grow to a size readable at a glance. The
     technical details that used to close the row now live inside the settings screen: they
     are something you go and look at, not something you watch. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:baselineAligned="false"
    android:padding="@dimen/screen_padding">

    <!-- Charging points: the nearest motorway and Supercharger sites, tap for the map.
         The bolt sits behind the text rather than below it, so both columns fit without
         giving up the graphic backdrop. -->
    <FrameLayout
        android:id="@+id/charging_card"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2"
        android:layout_marginEnd="@dimen/card_gap"
        android:background="@drawable/smallcard_selector"
        android:clickable="true"
        android:focusable="true">

        <!-- Explicit size: at wrap_content the bolt would stay at the drawable's intrinsic
             36dp. Set as the background rather than the src: a background always fills the
             view bounds exactly, while every scaleType left slack inside the box and the
             bolt floated well above where the margins said it should sit. The box keeps the
             source 36:47 ratio to within 0.1%, so nothing is visibly stretched. -->
        <ImageView
            android:layout_width="@dimen/charging_bolt_width"
            android:layout_height="@dimen/charging_bolt_height"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="@dimen/charging_bolt_margin_end"
            android:layout_marginBottom="@dimen/charging_bolt_margin_bottom"
            android:alpha="0.12"
            android:background="@drawable/ic_charging_bolt"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="@dimen/charging_card_padding_h"
            android:paddingEnd="@dimen/charging_card_padding_h"
            android:paddingTop="@dimen/info_card_padding"
            android:paddingBottom="@dimen/info_card_padding">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/charging_title"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/small_card_label_size"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/charging_card_results"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="14dp"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/card_gap"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/charge_group_motorway"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="@string/charging_filter_motorway"
                        android:textColor="@color/accent"
                        android:textSize="@dimen/charge_detail_size"
                        android:textStyle="bold" />

                    <include layout="@layout/part_charge_summary" android:id="@+id/charge_row_0" />
                    <include layout="@layout/part_charge_summary" android:id="@+id/charge_row_1" />
                    <include layout="@layout/part_charge_summary" android:id="@+id/charge_row_2" />
                    <include layout="@layout/part_charge_summary" android:id="@+id/charge_row_3" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/charge_group_supercharger"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="@string/charging_filter_supercharger"
                        android:textColor="@color/accent"
                        android:textSize="@dimen/charge_detail_size"
                        android:textStyle="bold" />

                    <include layout="@layout/part_charge_summary" android:id="@+id/charge_row_4" />
                    <include layout="@layout/part_charge_summary" android:id="@+id/charge_row_5" />
                    <include layout="@layout/part_charge_summary" android:id="@+id/charge_row_6" />
                    <include layout="@layout/part_charge_summary" android:id="@+id/charge_row_7" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/charging_card_status"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="16dp"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/info_card_body_size" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/charging_attribution"
                android:textColor="@color/text_tertiary"
                android:textSize="@dimen/secondary_text_size" />
        </LinearLayout>
    </FrameLayout>

    <!-- Launcher settings. Summarises what is on, so the card says something before anyone
         touches it, and carries the round button that opens the settings screen. The whole
         card stays tappable too: in a moving car the larger target is the kinder one. -->
    <FrameLayout
        android:id="@+id/settings_card"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/smallcard_selector"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="@dimen/info_card_padding">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_title"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/small_card_label_size"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/settings_card_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:lineSpacingExtra="6dp"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/info_card_body_size" />
        </LinearLayout>

        <ImageView
            android:id="@+id/settings_card_button"
            android:layout_width="@dimen/round_button_size"
            android:layout_height="@dimen/round_button_size"
            android:layout_gravity="bottom|end"
            android:layout_margin="@dimen/info_card_padding"
            android:background="@drawable/round_button_selector"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/settings_title"
            android:padding="@dimen/round_button_icon_padding"
            android:src="@drawable/ic_gear" />
    </FrameLayout>
</LinearLayout>
