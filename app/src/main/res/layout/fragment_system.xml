<?xml version="1.0" encoding="utf-8"?>
<!-- Carousel page 3: live system information, refreshed while the page is visible.
     All values are read without dangerous permissions. Landscape (MG4 head unit).
     Every reading lives in a single "technical details" card; the other three slots
     are free for features still to be designed. The card scrolls only if its content
     ever outgrows it — fillViewport keeps the weighted spacing when it doesn't. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:baselineAligned="false"
    android:padding="@dimen/screen_padding">

    <!-- Technical details: device, memory, storage, network -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginEnd="@dimen/card_gap"
        android:background="@drawable/smallcard_selector"
        android:fillViewport="true"
        android:padding="@dimen/info_card_padding"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sys_technical"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/small_card_label_size"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_device_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:lineSpacingExtra="6dp"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/info_card_body_size" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="16dp" />

            <!-- Memory -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sys_memory"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/info_card_body_size" />

            <TextView
                android:id="@+id/tv_memory_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/sys_value_size"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sys_used_total"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/info_card_body_size" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="16dp" />

            <!-- Storage -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sys_storage"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/info_card_body_size" />

            <TextView
                android:id="@+id/tv_storage_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/sys_value_size"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sys_free_total"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/info_card_body_size" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="16dp" />

            <!-- Network -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sys_network"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/info_card_body_size" />

            <TextView
                android:id="@+id/tv_network_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/sys_value_size"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_network_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/info_card_body_size" />
        </LinearLayout>
    </ScrollView>

    <!-- Free slot 1 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginEnd="@dimen/card_gap"
        android:background="@drawable/smallcard_selector"
        android:gravity="center"
        android:orientation="vertical" />

    <!-- Free slot 2 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginEnd="@dimen/card_gap"
        android:background="@drawable/smallcard_selector"
        android:gravity="center"
        android:orientation="vertical" />

    <!-- Free slot 3 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/smallcard_selector"
        android:gravity="center"
        android:orientation="vertical" />
</LinearLayout>
