<?xml version="1.0" encoding="utf-8"?>
<!-- Technical details, on a screen of their own.

     No cards. They were four, one per subject, and each had to be a card's worth of content
     or look empty — which capped the screen at what four cards hold just as more was worth
     saying about the car's own connection. A list of labelled rows in two columns holds
     twenty readings as comfortably as eight, reads down a column instead of zig-zagging
     between boxes, and leaves the bottom free for the one thing here that wants to be drawn
     rather than written.

     The rows themselves are built in code: adding a reading should not mean editing a
     layout, and nothing here is worth an <include> per line. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/technical_back_button"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/icon_press_selector"
            android:clickable="true"
            android:contentDescription="@string/cd_back"
            android:focusable="true"
            android:padding="12dp"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/sys_technical"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/drawer_title_size"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Three columns. Left: the machine. Middle: what it is connected to. Right: what that
         connection has cost against MG's monthly gigabyte. Three because the screen is 1920
         wide and a column that runs past the bottom edge is worse than one that is short. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/card_gap"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/details_left"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/detail_column_gap"
            android:layout_weight="1"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/details_middle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/detail_column_gap"
            android:layout_weight="1"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/details_right"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical" />
    </LinearLayout>
</LinearLayout>
