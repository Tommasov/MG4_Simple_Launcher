<?xml version="1.0" encoding="utf-8"?>
<!-- Technical details, on a screen of their own. They used to sit on the tools page, where
     they were the one card nobody needs while driving; here they are four cards across the
     full width, which is room enough to read them without squinting. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/technical_back_button"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/icon_press_selector"
            android:clickable="true"
            android:contentDescription="@string/cd_back"
            android:focusable="true"
            android:padding="12dp"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/sys_technical"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/drawer_title_size"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/card_gap"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- The device itself: model, Android version, uptime, launcher build -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/card_gap"
            android:layout_weight="1"
            android:background="@drawable/smallcard_selector"
            android:orientation="vertical"
            android:padding="@dimen/info_card_padding">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sys_device"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/small_card_label_size"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_device_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:lineSpacingExtra="6dp"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/info_card_body_size" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/card_gap"
            android:layout_weight="1"
            android:background="@drawable/smallcard_selector"
            android:orientation="vertical"
            android:padding="@dimen/info_card_padding">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sys_memory"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/small_card_label_size"
                android:textStyle="bold" />

            <TextView
                android:layout_marginTop="16dp"
                android:id="@+id/tv_memory_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/sys_value_size"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sys_used_total"
                android:textColor="@color/text_tertiary"
                android:textSize="@dimen/secondary_text_size" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="16dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/card_gap"
            android:layout_weight="1"
            android:background="@drawable/smallcard_selector"
            android:orientation="vertical"
            android:padding="@dimen/info_card_padding">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sys_storage"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/small_card_label_size"
                android:textStyle="bold" />

            <TextView
                android:layout_marginTop="16dp"
                android:id="@+id/tv_storage_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/sys_value_size"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sys_free_total"
                android:textColor="@color/text_tertiary"
                android:textSize="@dimen/secondary_text_size" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="16dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/smallcard_selector"
            android:orientation="vertical"
            android:padding="@dimen/info_card_padding">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sys_network"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/small_card_label_size"
                android:textStyle="bold" />

            <TextView
                android:layout_marginTop="16dp"
                android:id="@+id/tv_network_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/sys_value_size"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_network_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_tertiary"
                android:textSize="@dimen/secondary_text_size" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="16dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
