<?xml version="1.0" encoding="utf-8"?>
<!-- Charging points: list on the left, map on the right. Landscape (MG4 head unit).
     The filter tabs reuse the SAIC top-tab artwork so the screen reads as native. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:padding="@dimen/screen_padding">

    <!-- Left column: back + title, filter tabs, results, attribution -->
    <LinearLayout
        android:layout_width="@dimen/charge_list_width"
        android:layout_height="match_parent"
        android:layout_marginEnd="@dimen/card_gap"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/charging_back_button"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/icon_press_selector"
                android:clickable="true"
                android:contentDescription="@string/cd_back"
                android:focusable="true"
                android:padding="12dp"
                android:src="@drawable/ic_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/charging_title"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/drawer_title_size"
                android:textStyle="bold" />

            <!-- Shown only while the motorway tab is the one on screen. That tab is the only
                 one with anything to configure — the other three mean the same thing on every
                 car — so a button always present would promise settings that do not exist.
                 Here rather than beside the tabs: the tab strip has four labels in 640dp and
                 no width to give away. -->
            <ImageView
                android:id="@+id/charging_motorway_options"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/icon_press_selector"
                android:clickable="true"
                android:contentDescription="@string/settings_motorway"
                android:focusable="true"
                android:padding="14dp"
                android:src="@drawable/ic_gear"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Filter tabs: a RadioGroup, exactly how the native energy screen does it. -->
        <RadioGroup
            android:id="@+id/charging_filters"
            android:layout_width="match_parent"
            android:layout_marginStart="@dimen/charge_list_inset"
            android:layout_marginEnd="@dimen/charge_list_inset"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_gap"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/filter_all"
                android:layout_width="0dp"
                android:layout_height="@dimen/filter_tab_height"
                android:layout_weight="1"
                android:background="@drawable/filter_tab_selector"
                android:button="@null"
                android:checked="true"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:text="@string/charging_filter_all"
                android:textColor="@color/filter_tab_text"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textSize="@dimen/filter_tab_text_size" />

            <RadioButton
                android:id="@+id/filter_motorway"
                android:layout_width="0dp"
                android:layout_height="@dimen/filter_tab_height"
                android:layout_weight="1"
                android:background="@drawable/filter_tab_selector"
                android:button="@null"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:text="@string/charging_filter_motorway"
                android:textColor="@color/filter_tab_text"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textSize="@dimen/filter_tab_text_size" />

            <RadioButton
                android:id="@+id/filter_supercharger"
                android:layout_width="0dp"
                android:layout_height="@dimen/filter_tab_height"
                android:layout_weight="1"
                android:background="@drawable/filter_tab_selector"
                android:button="@null"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:text="@string/charging_filter_supercharger"
                android:textColor="@color/filter_tab_text"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textSize="@dimen/filter_tab_text_size" />

            <RadioButton
                android:id="@+id/filter_fast"
                android:layout_width="0dp"
                android:layout_height="@dimen/filter_tab_height"
                android:layout_weight="1"
                android:background="@drawable/filter_tab_selector"
                android:button="@null"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:text="@string/charging_filter_fast"
                android:textColor="@color/filter_tab_text"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textSize="@dimen/filter_tab_text_size" />
        </RadioGroup>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/card_gap"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/charging_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false" />

            <!-- One slot for every non-result state: loading, empty, error, no permission. -->
            <TextView
                android:id="@+id/charging_status"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="@dimen/info_card_padding"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/info_card_body_size"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Attribution and the caveat on one line, the way the card carries them. Stacked
             they took two lines off the bottom of the list for what is a single aside. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="@dimen/charge_list_inset"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/charging_attribution"
                android:textColor="@color/text_tertiary"
                android:textSize="@dimen/secondary_text_size" />

            <TextView
                android:id="@+id/charging_arrival_note"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/charging_note_separator"
                android:textColor="@color/text_tertiary"
                android:textSize="@dimen/secondary_text_size"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Right: the map, with the navigation action floating over it once a point is picked -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <org.osmdroid.views.MapView
            android:id="@+id/charging_map"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- What is known about the station you picked. It lives over the map, at the bottom,
             because the list column is too narrow to read a price in and because the map is
             where the eye already is once a pin is highlighted. Hidden until something is
             selected, and taken away again when the selection clears. -->
        <!-- What is known about the station you picked. Over the map, at the bottom, because
             the list column is too narrow to read a price in and the eye is already on this
             side once a pin lights up. Hidden until something is selected.

             The height is fixed rather than wrapped on purpose: the card artwork is a
             429x298 bitmap, and a background contributes its intrinsic height as the view's
             minimum, so a wrapped panel could never be shorter than 298dp however little it
             had to say. Every line inside is a single line, so the content height is known. -->
        <LinearLayout
            android:id="@+id/charging_detail_panel"
            android:layout_width="match_parent"
            android:layout_height="@dimen/charge_detail_panel_height"
            android:layout_gravity="bottom"
            android:layout_margin="@dimen/card_gap"
            android:background="@drawable/smallcard_selector"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/charge_detail_padding_h"
            android:paddingEnd="@dimen/charge_detail_padding_h"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/charging_detail_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/charge_item_title_size"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/charging_detail_address"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/secondary_text_size" />

                <TextView
                    android:id="@+id/charging_detail_connectors"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/secondary_text_size" />

                <include
                    layout="@layout/part_charge_extras"
                    android:id="@+id/charging_detail_extras"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/charging_navigate_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:background="@drawable/map_button_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/native_button_padding_h"
                android:paddingVertical="@dimen/native_button_padding_v"
                android:visibility="gone">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_navigate"
                    app:tint="@android:color/white" />

                <TextView
                    android:id="@+id/charging_navigate_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/charging_send_to_navigation"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/drawer_button_size" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
