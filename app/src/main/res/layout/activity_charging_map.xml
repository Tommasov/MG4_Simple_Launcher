<?xml version="1.0" encoding="utf-8"?>
<!-- Charging points: list on the left, map on the right. Landscape (MG4 head unit).
     The filter tabs reuse the SAIC top-tab artwork so the screen reads as native. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:padding="@dimen/screen_padding">

    <!-- Left column: back + title, filter tabs, results, attribution -->
    <LinearLayout
        android:layout_width="@dimen/charge_list_width"
        android:layout_height="match_parent"
        android:layout_marginEnd="@dimen/card_gap"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/charging_back_button"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/icon_press_selector"
                android:clickable="true"
                android:contentDescription="@string/cd_back"
                android:focusable="true"
                android:padding="12dp"
                android:src="@drawable/ic_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/charging_title"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/drawer_title_size"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Filter tabs: a RadioGroup, exactly how the native energy screen does it. -->
        <RadioGroup
            android:id="@+id/charging_filters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_gap"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/filter_all"
                android:layout_width="0dp"
                android:layout_height="@dimen/filter_tab_height"
                android:layout_weight="1"
                android:background="@drawable/filter_tab_selector"
                android:button="@null"
                android:checked="true"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:text="@string/charging_filter_all"
                android:textColor="@color/filter_tab_text"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textSize="@dimen/filter_tab_text_size" />

            <RadioButton
                android:id="@+id/filter_motorway"
                android:layout_width="0dp"
                android:layout_height="@dimen/filter_tab_height"
                android:layout_weight="1"
                android:background="@drawable/filter_tab_selector"
                android:button="@null"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:text="@string/charging_filter_motorway"
                android:textColor="@color/filter_tab_text"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textSize="@dimen/filter_tab_text_size" />

            <RadioButton
                android:id="@+id/filter_supercharger"
                android:layout_width="0dp"
                android:layout_height="@dimen/filter_tab_height"
                android:layout_weight="1"
                android:background="@drawable/filter_tab_selector"
                android:button="@null"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:text="@string/charging_filter_supercharger"
                android:textColor="@color/filter_tab_text"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textSize="@dimen/filter_tab_text_size" />

            <RadioButton
                android:id="@+id/filter_fast"
                android:layout_width="0dp"
                android:layout_height="@dimen/filter_tab_height"
                android:layout_weight="1"
                android:background="@drawable/filter_tab_selector"
                android:button="@null"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:text="@string/charging_filter_fast"
                android:textColor="@color/filter_tab_text"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textSize="@dimen/filter_tab_text_size" />
        </RadioGroup>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/card_gap"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/charging_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false" />

            <!-- One slot for every non-result state: loading, empty, error, no permission. -->
            <TextView
                android:id="@+id/charging_status"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="@dimen/info_card_padding"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/info_card_body_size"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/charging_attribution"
            android:textColor="@color/text_tertiary"
            android:textSize="@dimen/charge_item_detail_size" />
    </LinearLayout>

    <!-- Right: the map, with the navigation action floating over it once a point is picked -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <org.osmdroid.views.MapView
            android:id="@+id/charging_map"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/charging_navigate_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="24dp"
            android:background="@drawable/map_button_selector"
            android:clickable="true"
            android:elevation="6dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/native_button_padding_h"
            android:paddingVertical="@dimen/native_button_padding_v"
            android:visibility="gone">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_navigate"
                app:tint="@android:color/white" />

            <TextView
                android:id="@+id/charging_navigate_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/charging_send_to_navigation"
                android:textColor="@android:color/white"
                android:textSize="@dimen/drawer_button_size"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
