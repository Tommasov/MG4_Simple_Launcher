<?xml version="1.0" encoding="utf-8"?>
<!-- All apps on top, the two fixed Android shortcuts below. Shared by both home
     layouts: whichever way the favourites are arranged, this column does not change. -->
<!-- Fourth column: all apps (top) + two fixed app shortcuts (bottom) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/card_all_apps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="@dimen/card_gap"
        android:background="@drawable/smallcard_selector"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/all_apps"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/small_card_label_size"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Two fixed shortcuts (Files + Settings), icons only, side by side on a single card. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/smallcard_selector"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/icon_files"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/icon_press_selector"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/cd_files"
            android:padding="@dimen/fixed_app_padding"
            android:scaleType="fitCenter" />

        <ImageView
            android:id="@+id/icon_settings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/icon_press_selector"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/cd_settings"
            android:padding="@dimen/fixed_app_padding"
            android:scaleType="fitCenter" />
    </LinearLayout>
</LinearLayout>
