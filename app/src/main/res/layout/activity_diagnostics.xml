<?xml version="1.0" encoding="utf-8"?>
<!-- Diagnostics log, read on the head unit because the car cannot be reached over adb.
     Monospaced and small on purpose: this is a stack trace, not prose. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/diagnostics_back_button"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/icon_press_selector"
            android:clickable="true"
            android:contentDescription="@string/cd_back"
            android:focusable="true"
            android:padding="12dp"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/diagnostics_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/drawer_title_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/diagnostics_copy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="@drawable/native_button_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="@dimen/native_button_padding_h"
            android:paddingVertical="@dimen/native_button_padding_v"
            android:text="@string/diagnostics_copy"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/drawer_button_size" />

        <TextView
            android:id="@+id/diagnostics_clear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="@drawable/native_button_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="@dimen/native_button_padding_h"
            android:paddingVertical="@dimen/native_button_padding_v"
            android:text="@string/diagnostics_clear"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/drawer_button_size" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/diagnostics_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/card_gap"
        android:layout_weight="1"
        android:background="@drawable/smallcard_selector"
        android:paddingStart="@dimen/diagnostics_padding_h"
        android:paddingEnd="@dimen/diagnostics_padding_h"
        android:paddingTop="@dimen/diagnostics_padding_top"
        android:paddingBottom="@dimen/diagnostics_padding_bottom">

        <TextView
            android:id="@+id/diagnostics_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/text_secondary"
            android:textIsSelectable="true"
            android:textSize="@dimen/diagnostics_text_size" />
    </ScrollView>
</LinearLayout>
