<?xml version="1.0" encoding="utf-8"?>
<!-- Carousel page 3: charging points, landscape (MG4 head unit).
     One list, not three columns. Three at once was more than anyone reads at a glance, and
     choosing which network mattered is not our call to make once and for all — the gear on
     the card makes it the driver's, and the card shows that one. The two buttons sit on the
     card because they act on the card: what it lists, and reading it again now. The launcher's
     own settings live on the right, off the card, where they cannot be mistaken for it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:padding="@dimen/screen_padding">

    <FrameLayout
        android:id="@+id/charging_card"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2"
        android:layout_marginEnd="@dimen/card_gap"
        android:background="@drawable/smallcard_selector"
        android:clickable="true"
        android:focusable="true">

        <!-- Explicit size: at wrap_content the bolt would stay at the drawable's intrinsic
             36dp. Set as the background rather than the src: a background always fills the
             view bounds exactly, while every scaleType left slack inside the box and the
             bolt floated well above where the margins said it should sit. The box keeps the
             source 36:47 ratio to within 0.1%, so nothing is visibly stretched. -->
        <ImageView
            android:layout_width="@dimen/charging_bolt_width"
            android:layout_height="@dimen/charging_bolt_height"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="@dimen/charging_bolt_margin_end"
            android:layout_marginBottom="@dimen/charging_bolt_margin_bottom"
            android:alpha="0.12"
            android:background="@drawable/ic_charging_bolt"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="@dimen/charging_card_padding_h"
            android:paddingEnd="@dimen/charging_card_padding_h"
            android:paddingTop="@dimen/charging_card_padding_v"
            android:paddingBottom="@dimen/charging_card_padding_v">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/charging_title"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/small_card_label_size"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/charging_card_results"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Says which network is on show, so the chosen filter is never a mystery. -->
                <TextView
                    android:id="@+id/charge_group_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:textColor="@color/accent"
                    android:textSize="@dimen/charge_detail_size"
                    android:textStyle="bold" />

                <include layout="@layout/part_charge_summary" android:id="@+id/charge_row_0" />
                <include layout="@layout/part_charge_summary" android:id="@+id/charge_row_1" />
                <include layout="@layout/part_charge_summary" android:id="@+id/charge_row_2" />
                <include layout="@layout/part_charge_summary" android:id="@+id/charge_row_3" />
                <include layout="@layout/part_charge_summary" android:id="@+id/charge_row_4" />
                <include layout="@layout/part_charge_summary" android:id="@+id/charge_row_5" />
            </LinearLayout>

            <TextView
                android:id="@+id/charging_card_status"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="16dp"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/info_card_body_size" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/charging_attribution"
                android:textColor="@color/text_tertiary"
                android:textSize="@dimen/secondary_text_size" />
        </LinearLayout>

        <!-- Both act on the card: reload it now, and choose what it lists. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="@dimen/charging_card_padding_v"
            android:layout_marginEnd="@dimen/charging_card_padding_h"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/charging_card_refresh"
                android:layout_width="@dimen/round_button_size"
                android:layout_height="@dimen/round_button_size"
                android:layout_marginEnd="12dp"
                android:background="@drawable/round_button_selector"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/charging_refresh"
                android:padding="@dimen/round_button_icon_padding"
                android:src="@drawable/ic_refresh" />

            <ImageView
                android:id="@+id/charging_card_options"
                android:layout_width="@dimen/round_button_size"
                android:layout_height="@dimen/round_button_size"
                android:background="@drawable/round_button_selector"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/charging_card_options"
                android:padding="@dimen/round_button_icon_padding"
                android:src="@drawable/ic_gear" />
        </LinearLayout>
    </FrameLayout>

    <!-- The launcher's settings: a button on the page, not a card. An empty card would read
         as something missing; bare background reads as room, and whatever comes next can
         bring its own card. -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- The author's other apps for this car. Above the settings because it is the one
             of the two that has something new to say from time to time. -->
        <LinearLayout
            android:id="@+id/downloads_button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/settings_tab_height"
            android:layout_marginBottom="@dimen/card_gap"
            android:background="@drawable/native_button_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/button_icon_size"
                android:layout_height="@dimen/button_icon_size"
                android:contentDescription="@null"
                android:src="@drawable/ic_download" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/downloads_title"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/drawer_button_size" />
        </LinearLayout>

        <!-- Icon and label as separate views rather than a compound drawable: a compound
             drawable is painted at the vector's intrinsic size, and ours is 96dp so it
             dwarfed the text. An ImageView scales to the box it is given. -->
        <LinearLayout
            android:id="@+id/settings_card_button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/settings_tab_height"
            android:background="@drawable/native_button_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/button_icon_size"
                android:layout_height="@dimen/button_icon_size"
                android:contentDescription="@null"
                android:src="@drawable/ic_gear" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/settings_title"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/drawer_button_size" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
