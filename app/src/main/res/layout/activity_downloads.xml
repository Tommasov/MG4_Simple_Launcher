<?xml version="1.0" encoding="utf-8"?>
<!-- The author's other apps for this car, offered for install or update. Deliberately plain:
     a list and a button per row, because everything else here is somebody else's software and
     the launcher's job is to fetch it, not to advertise it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/downloads_back_button"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/icon_press_selector"
            android:clickable="true"
            android:contentDescription="@string/cd_back"
            android:focusable="true"
            android:padding="12dp"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/downloads_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/drawer_title_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/downloads_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/native_button_selector"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="@dimen/native_button_padding_h"
            android:paddingVertical="@dimen/native_button_padding_v"
            android:text="@string/charging_refresh"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/drawer_button_size" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/card_gap"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/downloads_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false" />

        <!-- One slot for every non-result state: loading, empty, no network. -->
        <TextView
            android:id="@+id/downloads_status"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="@dimen/info_card_padding"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/info_card_body_size"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
