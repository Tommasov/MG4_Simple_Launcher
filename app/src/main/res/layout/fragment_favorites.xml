                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/add_favorite"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/grid_label_size" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/slot_6"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/smallcard_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/slot_icon_6"
                android:layout_width="@dimen/grid_icon_size"
                android:layout_height="@dimen/grid_icon_size"
                android:contentDescription="@string/add_favorite" />

            <TextView
                android:id="@+id/slot_label_6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
