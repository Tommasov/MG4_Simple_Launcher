<?xml version="1.0" encoding="utf-8"?>
<!-- Carousel page 2: eight assignable shortcuts. Four columns of two stacked cards,
     so every tile has the same proportions as the half cards in the home page's
     fourth column. Landscape (MG4 head unit, 1920x720).
     Slots read left to right: 0-3 on the top row, 4-7 on the bottom row. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:baselineAligned="false"
    android:padding="@dimen/screen_padding">

    <!-- Column 1: slots 0 / 4 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginEnd="@dimen/card_gap"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/slot_0"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="@dimen/card_gap"
            android:background="@drawable/smallcard_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/slot_icon_0"
                android:layout_width="@dimen/grid_icon_size"
                android:layout_height="@dimen/grid_icon_size"
                android:contentDescription="@string/add_favorite" />

            <TextView
                android:id="@+id/slot_label_0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/add_favorite"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/grid_label_size" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/slot_4"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/smallcard_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/slot_icon_4"
                android:layout_width="@dimen/grid_icon_size"
                android:layout_height="@dimen/grid_icon_size"
                android:contentDescription="@string/add_favorite" />

            <TextView
                android:id="@+id/slot_label_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/add_favorite"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/grid_label_size" />
        </LinearLayout>
    </LinearLayout>

    <!-- Column 2: slots 1 / 5 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginEnd="@dimen/card_gap"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/slot_1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
